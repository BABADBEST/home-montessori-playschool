# Server port
PORT=3000

# Owner Portal PIN (used to access / manage inquiries, enrollments, and email settings in the Owner Portal)
OWNER_PIN=4784

# Optional Direct SMTP Configuration (e.g., Gmail App Password, Outlook, or Resend SMTP)
# Note: Even without SMTP configured below, the site automatically delivers formatted emails
# via FormSubmit.co directly to your configured business email address!
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
